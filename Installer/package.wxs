<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="VisionCounter"
      Manufacturer="Adtec Plasma Technology Vietnam"
      Version="1.0.0.9"
      UpgradeCode="0A458AEE-BBF5-4283-9C7B-F62CB4CE6DFE">

    <!-- Major Upgrade configuration: enables upgrading previous versions -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Embedding cabinet files in MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Application Icon and ARP settings (Icon ID must end with .exe to match advertised shortcut target's extension per ICE50) -->
    <Icon Id="AppIcon.exe" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />

    <!-- Directory Structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CounterVision" />
    </StandardDirectory>

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="CounterVisionAppData" Name="CounterVision">
        <Directory Id="ModelsAppData" Name="Models" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CounterVision" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Features -->
    <Feature Id="Main">
      <!-- Main App Components -->
      <ComponentGroupRef Id="MainAppComponents" />
      <!-- Harvested Files -->
      <ComponentGroupRef Id="HarvestedFilesComponents" />
    </Feature>

    <!-- Component Group for Executable and Shortcuts -->
    <ComponentGroup Id="MainAppComponents">
      <!-- Main Executable with Shortcuts -->
      <Component Id="MainExecutableComponent" Directory="INSTALLFOLDER" Guid="A76F12C0-1200-47E3-9C7B-F62CB4CE6DFE">
        <File Id="MainExecutable" Source="..\bin\Release\net8.0-windows\win-x64\publish\VisionCounter.exe" KeyPath="yes" />
        
        <!-- Shortcuts (Advertised shortcuts resolve ICE43 and ICE57 errors) -->
        <Shortcut Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Name="CounterVision" Icon="AppIcon.exe" Advertise="yes" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="CounterVision" Icon="AppIcon.exe" Advertise="yes" />
        
        <!-- Cleanup of Start Menu folder on uninstall -->
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>

      <!-- AppData config folder with active.json, never overwrite on upgrade if modified -->
      <Component Id="AppDataConfigComponent" Directory="ModelsAppData" Guid="B4E3089D-2BF5-4283-9C7B-F62CB4CE6DFE" NeverOverwrite="yes">
        <RegistryValue Root="HKCU" Key="Software\AdtecPlasmaTechnology\CounterVision" Name="AppDataInstalled" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ActiveJsonFile" Source="..\Models\active.json" />
        
        <!-- Cleanup of AppData directories on uninstall to resolve ICE64 -->
        <RemoveFolder Id="RemoveModelsAppData" Directory="ModelsAppData" On="uninstall" />
        <RemoveFolder Id="RemoveCounterVisionAppData" Directory="CounterVisionAppData" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Component Group for dynamic file harvesting -->
    <ComponentGroup Id="HarvestedFilesComponents" Directory="INSTALLFOLDER">
      <!-- Harvest all files from the publish folder, excluding the main executable since we declare it statically -->
      <Files Include="..\bin\Release\net8.0-windows\win-x64\publish\**">
        <Exclude Files="..\bin\Release\net8.0-windows\win-x64\publish\VisionCounter.exe" />
      </Files>
    </ComponentGroup>

    <!-- UI configuration -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Launch application after installation -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch CounterVision" />
    <Property Id="WixShellExecTarget" Value="[#MainExecutable]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>

</Wix>