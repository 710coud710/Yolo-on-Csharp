<UserControl x:Class="Client.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition MaxWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- Output Image Card -->
        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#E5E5EA"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <!-- Zoomable Image Container -->
                <Grid x:Name="ImageContainer" Background="#0A0A0C" ClipToBounds="True" Margin="8"
                      MouseWheel="ImageContainer_MouseWheel"
                      MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                      MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                      MouseMove="ImageContainer_MouseMove">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Image x:Name="ResultImage"
                           Source="{Binding OutputImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Zoom Control Toolbar -->
                    <Border Background="#A0000000"
                            CornerRadius="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnZoomIn" Click="BtnZoomIn_Click" ToolTip="Zoom In" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <materialDesign:PackIcon Kind="Plus" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnZoomOut" Click="BtnZoomOut_Click" ToolTip="Zoom Out" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <materialDesign:PackIcon Kind="Minus" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnZoomReset" Click="BtnZoomReset_Click" ToolTip="Reset Zoom" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <materialDesign:PackIcon Kind="ArrowExpandAll" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="Scroll to Zoom | Drag to Pan" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Loading overlay while downloading output image -->
                <Border Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        CornerRadius="16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Width="220"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="No result image"
                           FontSize="16"
                           Foreground="#8E8E93"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Info Panel Card -->
        <Border Grid.Column="2"
                Background="#FFFFFF"
                BorderBrush="#E5E5EA"
                BorderThickness="1"
                CornerRadius="16"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header + Back button -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Result"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1C1C1E"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding BackCommand}"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16"
                                        BorderThickness="1"
                                        BorderBrush="#E5E5EA">
                                    <materialDesign:PackIcon Kind="ArrowLeft"
                                                             Width="18"
                                                             Height="18"
                                                             Foreground="#007AFF"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F2F7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <!-- Title Square Box  -->
                <TextBlock Text="TOTAL COUNT" 
                    FontSize="15" 
                    FontWeight="Bold" 
                    Foreground="#1d6910" 
                    HorizontalAlignment="Center"/>
                <!-- Highlight Square Box for Count -->
                <Border Width="270"
                        Height="240"
                        Background="#ceffcd"
                        BorderBrush="#CCE3FF"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#007AFF" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                           
                            <TextBlock Text="{Binding TotalDetections, Mode=OneWay}" 
                                       FontSize="142" 
                                       FontWeight="Bold" 
                                       Foreground="#1d6910" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Additional Metadata Content Rows -->
                <StackPanel Margin="8,5,8,0">
                    <!--<Border BorderThickness="0,0,0,1" BorderBrush="#F2F2F7" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Status" FontWeight="Medium" Foreground="#8E8E93" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#1C1C1E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                    </Border>-->

                    <!--<Border BorderThickness="0,0,0,1" BorderBrush="#F2F2F7" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Image ID" FontWeight="Medium" Foreground="#8E8E93" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding ImageId, Mode=OneWay}" Foreground="#1C1C1E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                    </Border>-->

                    <Border BorderThickness="0,0,0,1" BorderBrush="#F2F2F7" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Machine" FontWeight="Medium" Foreground="#8E8E93" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding MachineName, Mode=OneWay}" Foreground="#1C1C1E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                    </Border>

                    <Border BorderThickness="0,0,0,1" BorderBrush="#F2F2F7" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Processing Time" FontWeight="Medium" Foreground="#8E8E93" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProcessingTimeMs, Mode=OneWay, StringFormat={}{0:0.##} ms}" Foreground="#1C1C1E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                    </Border>

                    <Border BorderThickness="0,0,0,1" BorderBrush="#F2F2F7" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Created" FontWeight="Medium" Foreground="#8E8E93" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Foreground="#1C1C1E" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
