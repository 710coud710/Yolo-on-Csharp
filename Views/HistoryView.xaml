<UserControl x:Class="Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Right controls -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <!-- Capsule Search Box -->
                <Border Background="#E5E5EA"
                        CornerRadius="10"
                        Height="36"
                        Width="360"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   Foreground="#8E8E93"
                                   VerticalAlignment="Center"
                                   Margin="12,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Padding="0,0,10,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search (machine name)..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                             Command="{Binding SearchHistoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Search Button -->
                <Button Command="{Binding SearchHistoryCommand}"
                        Width="96"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#007AFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0062CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshHistoryCommand}"
                        Width="104"
                        Height="36"
                        Margin="0,0,10,0"
                        Background="#E5F1FF"
                        Foreground="#007AFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#007AFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CCE3FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Clear Button -->
                <!-- <Button Command="{Binding ClearHistoryCommand}"
                        Width="92"
                        Height="36"
                        Background="#FF3B30"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E0352B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button> -->
            </StackPanel>
        </Grid>

        <!-- History List Card -->
        <Border Grid.Row="1" 
                Background="#FFFFFF" 
                BorderBrush="#E5E5EA" 
                BorderThickness="1" 
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <DataGrid ItemsSource="{Binding History}"
                          SelectedItem="{Binding SelectedLog}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" 
                                            Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                            Width="180"/>
                        <DataGridTextColumn Header="Machine" 
                                            Binding="{Binding MachineName}" 
                                            Width="140"/>
                        <DataGridTextColumn Header="Material Code" 
                                            Binding="{Binding ItemCode}" 
                                            Width="130"/>
                        <DataGridTextColumn Header="Material Name" 
                                            Binding="{Binding ItemName}" 
                                            Width="160"/>
                        <DataGridTextColumn Header="Quantity" 
                                            Binding="{Binding TotalObjects}" 
                                            Width="90"/>
                        <DataGridTextColumn Header="Raw Image Path" 
                                            Binding="{Binding ImagePath}" 
                                            Width="*"/>
                        <DataGridTextColumn Header="Result Image Path" 
                                            Binding="{Binding ResultImagePath}" 
                                            Width="*"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View"
                                            Command="{Binding DataContext.ViewResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="28"
                                            Background="#E5F1FF"
                                            Foreground="#007AFF"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="14"
                                                                    Padding="12,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#CCE3FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#8E8E93"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5EA"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F2F2F7"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F1FF"/>
                                    <Setter Property="Foreground" Value="#007AFF"/>                                    
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F1FF"/>
                                    <Setter Property="Foreground" Value="#007AFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Empty State -->
                <TextBlock Text="No detection history available" 
                            FontSize="16" 
                            Foreground="#8E8E93"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding History.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <!-- Loading Overlay -->
                <Border Background="#80FFFFFF"
                        CornerRadius="16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Loading history..."
                                   Foreground="#1C1C1E"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Width="200"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Consolidated Footer -->
        <Border Grid.Row="2" 
                Background="#FFFFFF" 
                BorderBrush="#E5E5EA" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="16,12" 
                Margin="0,16,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}" 
                           Foreground="#8E8E93"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                
                <!-- Pagination Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding PrevPageCommand}"
                            Width="32" 
                            Height="32"
                            Margin="0,0,10,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Previous Page">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22" Foreground="#1C1C1E"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F2F7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                         <TextBlock Text="Page " Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                         <TextBlock Text="{Binding PageNumber}" FontWeight="Bold" Foreground="#007AFF" FontSize="13" VerticalAlignment="Center"/>
                         <TextBlock Text=" of " Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                         <TextBlock Text="{Binding TotalPages, FallbackValue=1}" FontWeight="Bold" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                         <TextBlock Text=" (" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                         <TextBlock Text="{Binding TotalCount}" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                         <TextBlock Text=" entries)" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                     </StackPanel>

                    <Button Command="{Binding NextPageCommand}"
                            Width="32" 
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Next Page">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22" Foreground="#1C1C1E"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F2F7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
