<UserControl x:Class="Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <UserControl.Resources>
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BackgroundBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="14" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- The sliding dot -->
                                <Border x:Name="Dot" 
                                        Background="White" 
                                        Width="24" 
                                        Height="24" 
                                        CornerRadius="12" 
                                        HorizontalAlignment="Left" 
                                        Margin="2,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="Black" Opacity="0.15"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#34C759"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Unlocked Main Settings Layout -->
        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                <Grid Margin="16,16,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" 
                               Text="Settings" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#1C1C1E"
                               Margin="0,0,0,16"/>

                    <!-- Settings Content -->
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: General Settings -->
                    <RowDefinition Height="10"/>   <!-- Row 1: Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Model & Camera Config -->
                    <RowDefinition Height="10"/>   <!-- Row 3: Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Image Settings -->
                    <RowDefinition Height="10"/>   <!-- Row 5: Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Row 6: Database & Security Settings -->
                </Grid.RowDefinitions>

                <!-- General Settings Card (Full width at the top) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="General Settings" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Model Process:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding ModelProcess, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Capture"/>
                                <ComboBoxItem Content="Stream"/>
                            </ComboBox>
                        </Border>

                        <!-- All Class Toggle Switch -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Detect All Classes:" 
                                           FontSize="13" 
                                           FontWeight="Medium" 
                                           Foreground="#8E8E93"/>
                                <TextBlock Text="Detect all classes instead of selected item code" 
                                           FontSize="11" 
                                           Foreground="#C7C7CC"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AllClass, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#E5E5EA" Margin="0,16,0,16"/>

                        <TextBlock Text="Region of Interest (ROI) - Percentage (0% - 100%)" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,12"/>

                        <!-- Grid for ROI inputs (X, Y, Width, Height) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- X -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ROI X (%):" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiX, Mode=TwoWay}" Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>

                            <!-- Y -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ROI Y (%):" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiY, Mode=TwoWay}" Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>

                            <!-- Width -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="ROI Width (%):" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiWidth, Mode=TwoWay}" Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>

                            <!-- Height -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ROI Height (%):" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiHeight, Mode=TwoWay}" Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Left Column (Model Settings) -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <!-- AI Model Configuration Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20"
                            Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="AI Model Configuration" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#1C1C1E"
                                       Margin="0,0,0,16"/>
                            
                            <!-- Confidence Threshold -->
                            <TextBlock Text="Confidence Threshold (0.0 - 1.0):" 
                                       Foreground="#8E8E93" 
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                                <TextBox Text="{Binding ConfidenceThreshold, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>

                            <!-- IoU Threshold -->
                            <TextBlock Text="IoU Threshold (0.0 - 1.0):" 
                                       Foreground="#8E8E93" 
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                                <TextBox Text="{Binding NmsThreshold, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>

                            <!-- Letterbox Toggle Switch -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Use Letterbox Resize:" 
                                               FontSize="13" 
                                               FontWeight="Medium" 
                                               Foreground="#8E8E93"/>
                                    <TextBlock Text="Preserve aspect ratio of image during scaling" 
                                               FontSize="11" 
                                               Foreground="#C7C7CC"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" 
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding UseLetterbox, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Enable Tiling Toggle Switch -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Image Tiling:" 
                                               FontSize="13" 
                                               FontWeight="Medium" 
                                               Foreground="#8E8E93"/>
                                    <TextBlock Text="Split image into tiles for processing" 
                                               FontSize="11" 
                                               Foreground="#C7C7CC"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" 
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding EnableTiling, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Tiling Overlap Ratio -->
                            <StackPanel Visibility="{Binding EnableTiling, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Tiling Overlap Ratio (0.0 - 0.5):" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                                    <TextBox Text="{Binding TilingOverlap, Mode=TwoWay}" 
                                             Padding="10,0"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>

                            <!-- Reload AI Engine Button -->
                            <!-- <StackPanel Margin="0,16,0,0">
                                <Button Content="Reload AI Engine" 
                                        Command="{Binding ReloadModelCommand}"
                                        Height="38" 
                                        Background="#007AFF" 
                                        Foreground="White" 
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="19"
                                                                Padding="16,0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0062CC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel> -->
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Camera Settings Card (Right) -->
                <Border Grid.Row="2" Grid.Column="2"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Camera Configuration" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Camera IP Address -->
                        <TextBlock Text="Camera IP Address:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <TextBox Text="{Binding CameraIpAddress, Mode=TwoWay}" 
                                     Padding="10,0"
                                     FontSize="13"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>

                        <!-- Trigger Mode Selector -->
                        <TextBlock Text="Trigger Mode:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <ComboBox SelectedValue="{Binding TriggerMode, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Software"/>
                                <ComboBoxItem Content="Hardware"/>
                            </ComboBox>
                        </Border>

                        <!-- Camera Resolution Selector -->
                        <TextBlock Text="Camera Resolution &amp; Frame Rate:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <ComboBox ItemsSource="{Binding SupportedResolutions}"
                                      SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Test Mode Toggle Switch -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Test Mode (Camera Simulator):" 
                                           FontSize="13" 
                                           FontWeight="Medium" 
                                           Foreground="#8E8E93"/>
                                <TextBlock Text="Bypass camera using local images for testing" 
                                           FontSize="11" 
                                           Foreground="#C7C7CC"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" 
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding TestMode, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Image Settings Card (Full width) -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Image Settings" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <CheckBox Content="Auto Save Captured Images" 
                                  IsChecked="{Binding AutoSave, Mode=TwoWay}"
                                  FontSize="13"
                                  FontWeight="Medium"
                                  Foreground="#3A3A3C"
                                  Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Save Directory:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                <TextBox Text="{Binding SaveDirectory, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                            
                            <Button Grid.Column="2"
                                    Content="Browse..." 
                                    Command="{Binding BrowseSaveDirectoryCommand}"
                                    Height="36" 
                                    Width="100"
                                    Background="#E5F1FF" 
                                    Foreground="#007AFF" 
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="18" 
                                                            Padding="10,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CCE3FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="Image Quality (%):" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider Grid.Column="0"
                                    Value="{Binding ImageQuality, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                <TextBox Text="{Binding ImageQuality, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Save Image Mode:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                            <ComboBox SelectedValue="{Binding SaveMode, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="NGOnly"/>
                                <ComboBoxItem Content="All"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Database & Security Settings Card (Full width) -->
                <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20" >
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Database &amp; Security Settings" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Connection String -->
                        <TextBlock Text="Database Connection String:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                <TextBox Text="{Binding DatabaseConnectionString, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                            
                            <Button Grid.Column="2"
                                    Content="Test Connection" 
                                    Command="{Binding TestConnectionCommand}"
                                    Height="36" 
                                    Width="140"
                                    Background="#E5F1FF" 
                                    Foreground="#007AFF" 
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="18" 
                                                            Padding="10,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CCE3FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Password Authentication Section Header & Button -->
                        <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                       Text="Security Settings:" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="#1C1C1E"
                                       VerticalAlignment="Center"/>
                            
                            <Button Grid.Column="2"
                                    Content="Change Machine Password"
                                    Command="{Binding ToggleChangePasswordCommand}"
                                    Height="32"
                                    Background="#E5F1FF"
                                    Foreground="#007AFF"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="16" 
                                                            Padding="12,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CCE3FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Password Change Inputs -->
                        <Grid Visibility="{Binding IsChangePasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Machine Password *:" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                    <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                 materialDesign:HintAssist.Hint="Required"/>
                                </Border>
                            </StackPanel>

                            <!-- New Password -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="New Password *:" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                    <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                 materialDesign:HintAssist.Hint="New password"/>
                                </Border>
                            </StackPanel>

                            <!-- Confirm New Password -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Confirm New Password *:" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                    <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                 materialDesign:HintAssist.Hint="Must match new password"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Sticky Bottom Action Footer Bar -->
            <Border Grid.Row="1" 
                    Background="#FFFFFF" 
                    BorderBrush="#E5E5EA" 
                    BorderThickness="0,1,0,0" 
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="#8E8E93"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2"
                            Content="Reset to Default" 
                            Command="{Binding ResetSettingsCommand}"
                            Height="40" 
                            Width="150"
                            Background="#F2F2F7" 
                            Foreground="#FF3B30" 
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="20" 
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E5EA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Grid.Column="4"
                            Content="Save Settings" 
                            Command="{Binding SaveSettingsCommand}"
                            Height="40" 
                            Width="150"
                            Background="#34C759" 
                            Foreground="White" 
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="20" 
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2EB852"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Locked Overlay Gate -->
        <Border Background="#F2F2F7"
                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="24"
                        Width="360"
                        Padding="32,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Lock Icon and Title -->
                        <materialDesign:PackIcon Kind="ShieldLockOutline"
                                                 Width="56"
                                                 Height="56"
                                                 Foreground="#FF9500"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,8,0,16"/>
                        
                        <TextBlock Text="Settings Protected"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1C1C1E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        
                        <TextBlock Text="Enter the password for this machine to access or modify settings."
                                   FontSize="13"
                                   Foreground="#8E8E93"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <!-- Password Input -->
                        <TextBlock Text="Machine Password"
                                   Foreground="#8E8E93"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="40" Margin="0,0,0,8">
                            <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding UnlockPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,0"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         materialDesign:HintAssist.Hint="Enter password"
                                         materialDesign:HintAssist.Foreground="#C7C7CC">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding UnlockCommand}"/>
                                </PasswordBox.InputBindings>
                            </PasswordBox>
                        </Border>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding UnlockErrorMessage}"
                                   Foreground="#FF3B30"
                                   FontSize="20"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="{Binding HasUnlockError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,0,0,10"
                                   HorizontalAlignment="Center"/>

                        <!-- Spacing if no error to prevent layout shifting -->
                        <Separator Height="8" Background="Transparent" Visibility="{Binding HasUnlockError, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <!-- Unlock Button -->
                        <Button Content="Unlock Settings"
                                Command="{Binding UnlockCommand}"
                                Height="40"
                                Background="#007AFF"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0062CC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
