<UserControl x:Class="Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" 
                        Text="Settings" 
                        FontSize="22" 
                        FontWeight="Bold" 
                        Foreground="#1C1C1E"
                        Margin="0,0,0,16"/>

            <!-- Settings Content -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left Column (Model & Database Settings) -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <!-- AI Model Configuration Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20"
                            Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="AI Model Configuration" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#1C1C1E"
                                       Margin="0,0,0,16"/>
                            
                            <TextBlock Text="Models Folder Directory:" 
                                       Foreground="#8E8E93" 
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                                <TextBox Text="{Binding ModelsDirectory, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                            
                            <TextBlock Text="Confidence Threshold (0.0 - 1.0):" 
                                       Foreground="#8E8E93" 
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                                <TextBox Text="{Binding ConfidenceThreshold, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Scan Folder"
                                        Command="{Binding ScanModelsCommand}"
                                        Height="36"
                                        Width="110"
                                        Background="#007AFF"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="18"
                                                                Padding="10,0">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0062CC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Camera Settings Card (Right) -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Camera Configuration" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Camera IP Address:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <TextBox Text="{Binding CameraIp, Mode=TwoWay}" 
                                     Padding="10,0"
                                     FontSize="13"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>
                        
                        <TextBlock Text="Trigger Mode:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36" Margin="0,0,0,16">
                            <ComboBox SelectedItem="{Binding TriggerMode, Mode=TwoWay}"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Software"/>
                                <ComboBoxItem Content="Hardware"/>
                            </ComboBox>
                        </Border>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Capture Width:" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                    <TextBox Text="{Binding CaptureWidth, Mode=TwoWay}" 
                                             Padding="10,0"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Capture Height:" 
                                           Foreground="#8E8E93" 
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                    <TextBox Text="{Binding CaptureHeight, Mode=TwoWay}" 
                                             Padding="10,0"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Image Settings Card (Full width) -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5EA"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Image Settings" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   Margin="0,0,0,16"/>
                        
                        <CheckBox Content="Auto Save Captured Images" 
                                  IsChecked="{Binding AutoSave, Mode=TwoWay}"
                                  FontSize="13"
                                  FontWeight="Medium"
                                  Foreground="#3A3A3C"
                                  Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Save Directory:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                <TextBox Text="{Binding SaveDirectory, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                            
                            <Button Grid.Column="2"
                                    Content="Browse..." 
                                    Command="{Binding BrowseSaveDirectoryCommand}"
                                    Height="36" 
                                    Width="100"
                                    Background="#E5F1FF" 
                                    Foreground="#007AFF" 
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="18" 
                                                            Padding="10,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CCE3FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="Image Quality (%):" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider Grid.Column="0"
                                    Value="{Binding ImageQuality, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            
                            <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                                <TextBox Text="{Binding ImageQuality, Mode=TwoWay}" 
                                         Padding="10,0"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Save Image Mode:" 
                                   Foreground="#8E8E93" 
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="36">
                            <ComboBox SelectedValue="{Binding SaveMode, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Padding="10,0"
                                      FontSize="13"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="NGOnly"/>
                                <ComboBoxItem Content="All"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Action Footer Card -->
            <Border Grid.Row="2" 
                    Background="#FFFFFF" 
                    BorderBrush="#E5E5EA" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Padding="16,12" 
                    Margin="0,16,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="#8E8E93"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2"
                            Content="Reset to Default" 
                            Command="{Binding ResetSettingsCommand}"
                            Height="40" 
                            Width="150"
                            Background="#F2F2F7" 
                            Foreground="#FF3B30" 
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="20" 
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E5EA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Grid.Column="4"
                            Content="Save Settings" 
                            Command="{Binding SaveSettingsCommand}"
                            Height="40" 
                            Width="150"
                            Background="#34C759" 
                            Foreground="White" 
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="20" 
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2EB852"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
