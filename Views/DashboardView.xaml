 <UserControl x:Class="Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition MaxWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Image Preview Area -->
            <Border Grid.Column="0" 
                    Background="#FFFFFF" 
                    BorderBrush="#E5E5EA" 
                    BorderThickness="1" 
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <!-- Camera Preview -->
                    <Viewbox Stretch="Uniform" Margin="8">
                        <Grid>
                            <Image x:Name="CameraPreview"                               
                                    Source="{Binding DisplayFrame}"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            
                            <!-- ROI Overlay Box (WPF border) -->
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Visibility="{Binding IsRoiOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RoiLeftStar}"/>
                                    <ColumnDefinition Width="{Binding RoiWidthStar}"/>
                                    <ColumnDefinition Width="{Binding RoiRightStar}"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding RoiTopStar}"/>
                                    <RowDefinition Height="{Binding RoiHeightStar}"/>
                                    <RowDefinition Height="{Binding RoiBottomStar}"/>
                                </Grid.RowDefinitions>
                                
                                <!-- The ROI Border is placed in the center cell -->
                                <Border Grid.Column="1" Grid.Row="1"
                                        BorderBrush="#FF9500"
                                        BorderThickness="2"
                                        Background="Transparent">
                                    <TextBlock Text="ROI" 
                                               Foreground="#FF9500" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Margin="4"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Left"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Viewbox>

                    <!-- Detect Loading Overlay -->
                    <Border Background="#80000000"
                            Visibility="{Binding IsDetecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Detecting..."
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <ProgressBar Width="200"
                                         Height="6"
                                         Margin="0,12,0,0"
                                         IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Placeholder when no camera -->
                    <TextBlock Text="Camera Preview" 
                               FontSize="16" 
                               Foreground="#8E8E93"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayFrame}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Cumulative Batch Total HUD Badge on Camera -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16"
                            Background="#E6FFFFFF"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,6"
                            Visibility="{Binding HasBatchIncrements, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="Black" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#34C759" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Total Pass: " Foreground="#8E8E93" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BatchTotalCount, StringFormat='{}{0:N0} pcs'}" Foreground="#1C1C1E" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Control Panel -->
            <Border Grid.Column="2" 
                    Background="#FFFFFF" 
                    BorderBrush="#E5E5EA" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Control Panel Header (Operations / Camera Settings + Toggle/Save Button) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Header Title -->
                        <TextBlock Grid.Column="0" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="#1C1C1E"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Operations"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsMode}" Value="True">
                                            <Setter Property="Text" Value="Camera Settings"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- Toggle Settings / Save Settings Button -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSettingsCommand}"
                                Height="30" 
                                Background="Transparent" 
                                Foreground="#007AFF" 
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="15" 
                                                        Padding="8,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Cog" Width="14" Height="14" Foreground="#007AFF" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Settings" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F2F2F7"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSettingsMode}" Value="True">
                                            <Setter Property="Background" Value="#34C759"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="15" 
                                                                Padding="10,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Save Setting" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSettingsMode}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#2EB852"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Normal Dashboard Operations Section -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <!-- Camera Status Bar with Live Dot Indicator & Reconnect Action -->
                        <Border Background="#F8F9FA" 
                                BorderBrush="#E5E5EA" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="10,8" 
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Dot Indicator -->
                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#34C759"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCameraConnected}" Value="False">
                                                    <Setter Property="Fill" Value="#FF9500"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Status Text -->
                                <TextBlock Grid.Column="1" 
                                           VerticalAlignment="Center" 
                                           FontSize="12" 
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="Camera: " FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                    <Run Text="{Binding StatusMessage, Mode=OneWay}" Foreground="#8E8E93"/>
                                </TextBlock>

                                <!-- Reconnect / Retry Button (Only visible if NOT connected) -->
                                <Button Grid.Column="2" 
                                        Command="{Binding ConnectCameraCommand}"
                                        ToolTip="Thử kết nối lại Camera"
                                        Height="24"
                                        Background="#E8F8EE" 
                                        Foreground="#198754" 
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Padding="6,0"
                                        Margin="4,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" Foreground="#198754" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                <TextBlock Text="Thử lại" FontSize="11" FontWeight="SemiBold" Foreground="#198754" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCameraConnected}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D1E7DD"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ====== TEST IMAGE MODE CODE ====== -->
                        <!-- Select/Clear Test Image Buttons -->
                        <Border BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16" Background="#FAFAFA"
                                Visibility="{Binding TestMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="TEST / SIMULATION MODE" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="#8E8E93" 
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Select Image Button -->
                                    <Button Command="{Binding SelectTestImageCommand}"
                                            Height="32" 
                                            Background="#E5F1FF" 
                                            Foreground="#007AFF" 
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Grid.Column="0">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ImageSearch" Width="14" Height="14" Margin="0,0,4,0" Foreground="#007AFF" VerticalAlignment="Center"/>
                                                <TextBlock Text="Select Image..." FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D0E7FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Clear Image Button (Only visible if an image is loaded) -->
                                    <Button Command="{Binding ClearTestImageCommand}"
                                            Width="32"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Background="#FFE5E5" 
                                            Foreground="#FF3B30" 
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Grid.Column="1"
                                            Visibility="{Binding HasTestImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Content>
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#FF3B30"/>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFD0D0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                
                                <!-- Loaded Indicator -->
                                <TextBlock Text="✓ Image Loaded (Camera Bypassed)" 
                                           Foreground="#34C759" 
                                           FontWeight="SemiBold" 
                                           FontSize="11" 
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding HasTestImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                        <!-- ================================== -->
                        <!-- Capture Mode Start Button -->
                        <Button
                                Command="{Binding StartCommand}"
                                Height="46" 
                                Background="#007AFF" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="23" 
                                                        Padding="10,0">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0062CC"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDetecting}" Value="True">
                                            <Setter Property="Background" Value="#E5E5EA"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E5E5EA"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ModelProcess}" Value="Stream">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Play" Width="18" Height="18" Foreground="White" />
                                <TextBlock Text="Start Count" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Selected Material Display (Read-Only) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <TextBlock Text="Target Item: " 
                                       FontWeight="Medium" 
                                       Foreground="#8E8E93"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding SelectedItem.ItemCode, TargetNullValue='None (Select on Items tab)'}" 
                                       FontWeight="SemiBold" 
                                       Foreground="#007AFF"
                                       FontSize="13"/>
                        </StackPanel>
                        
                        <!-- Stream Mode Toggle Button -->
                        <Button
                                Command="{Binding ToggleStreamDetectionCommand}"
                                Height="46" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="#34C759"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="23" 
                                                        Padding="10,0">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModelProcess}" Value="Stream">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2EB852"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsStreamingDetectionActive}" Value="True">
                                            <Setter Property="Background" Value="#FF3B30"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsStreamingDetectionActive}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#E0352B"/>
                                        </MultiDataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E5E5EA"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Width="18" Height="18" Foreground="White">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="Play"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreamingDetectionActive}" Value="True">
                                                    <Setter Property="Kind" Value="Stop"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Start Stream"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreamingDetectionActive}" Value="True">
                                                    <Setter Property="Text" Value="Stop Stream"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Cumulative Batch Total Card -->
                        <Border Margin="0,12,0,0" 
                                Background="#F2F8F4" 
                                BorderBrush="#D1E7DD" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="12,4">
                            <StackPanel>
                                <!-- Card Header: Tiêu đề + Nút Chi tiết (Mở rộng / Thu gọn) + Nút Reset -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" 
                                                                 Width="18" 
                                                                 Height="18" 
                                                                 Foreground="#34C759" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="Total Count (PASS)" 
                                                   FontWeight="Bold" 
                                                   Foreground="#198754" 
                                                   FontSize="12" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Nút Mở rộng / Ẩn chi tiết -->
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleBatchDetailsCommand}"
                                            ToolTip="Bấm để xem hoặc ẩn danh sách chi tiết từng lần cộng"
                                            Height="26"
                                            Background="#E8F8EE"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="8,0"
                                            Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D1E7DD"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#198754" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="details"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBatchDetailsOpen}" Value="True">
                                                                <Setter Property="Text" Value="close"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <materialDesign:PackIcon Width="14" Height="14" Foreground="#198754" VerticalAlignment="Center" Margin="3,0,0,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ChevronDown"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBatchDetailsOpen}" Value="True">
                                                                <Setter Property="Kind" Value="ChevronUp"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nút Reset về 0 -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ResetBatchCounterCommand}"
                                            ToolTip="Đặt lại tổng về 0 (Reset)"
                                            Width="26" Height="26"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                                <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF0000"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Tổng đếm (Hiển thị mặc định ở chế độ bình thường, bấm vào để mở rộng/thu gọn chi tiết) -->
                                <Grid Margin="0,0,0,0" Cursor="Hand" ToolTip="Bấm để xem/ẩn chi tiết từng lần cộng">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleBatchDetailsCommand}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Số lượng tổng to rõ -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding BatchTotalCount, FallbackValue=0, StringFormat='{}{0:N0}'}" 
                                                   FontWeight="Bold" 
                                                   FontSize="38" 
                                                   Foreground="#198754"
                                                   VerticalAlignment="Bottom"/>
                                        <TextBlock Text=" pcs" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#8E8E93" 
                                                   Margin="4,0,0,4" 
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <!-- Huy hiệu lần cộng gần nhất (nếu có) -->
                                    <Border Grid.Column="1"
                                            Background="#D4EDDA"
                                            CornerRadius="10"
                                            Padding="6,3"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasBatchIncrements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding LastBatchIncrementText}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="#155724"/>
                                    </Border>
                                </Grid>

                                <!-- DANH SÁCH CHI TIẾT TỪNG LẦN (Mở rộng ngay bên dưới khi bấm vào, bình thường ẩn đi) -->
                                <StackPanel Visibility="{Binding IsBatchDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,6,0,0">
                                    
                                    <Separator Background="#D1E7DD" Margin="0,0,0,8" Height="1"/>

                                    <!-- <TextBlock Text="Chi tiết các lần cộng dồn:" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="#8E8E93" 
                                               Margin="0,0,0,6"/> -->

                                    <!-- Dải chip các lần cộng (+100 +110 +98) -->
                                    <!-- <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Margin="0,0,0,6"
                                                  Visibility="{Binding HasBatchIncrements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding BatchIncrements}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF"
                                                            BorderBrush="#34C759"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Margin="0,0,6,2"
                                                            ToolTip="{Binding TooltipText}"
                                                            Cursor="Help">
                                                        <TextBlock Text="{Binding DisplayText, Mode=OneWay}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="12" 
                                                                   Foreground="#198754"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer> -->

                                    <!-- Danh sách cuộn chi tiết từng dòng -->
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E5E5EA"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6"
                                            MaxHeight="150">
                                        <Grid>
                                            <!-- Khi có dữ liệu -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding HasBatchIncrements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding BatchIncrements}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#F2F2F7" BorderThickness="0,0,0,1" Padding="4,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" 
                                                                               Text="{Binding Index, Mode=OneWay, StringFormat='#{0}'}" 
                                                                               FontWeight="SemiBold" 
                                                                               FontSize="11" 
                                                                               Foreground="#8E8E93" 
                                                                               Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" 
                                                                               FontSize="11" 
                                                                               Foreground="#1C1C1E">
                                                                        <Run Text="{Binding DisplayText, Mode=OneWay}" FontWeight="Bold" Foreground="#198754"/>
                                                                        <Run Text=" (" Foreground="#8E8E93"/>
                                                                        <Run Text="{Binding ItemCode, Mode=OneWay}" Foreground="#007AFF"/>
                                                                        <Run Text=") - " Foreground="#8E8E93"/>
                                                                        <Run Text="{Binding FormattedTime, Mode=OneWay}" Foreground="#8E8E93"/>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" 
                                                                               Text="{Binding RunningTotal, Mode=OneWay, StringFormat='Σ {0}'}" 
                                                                               FontWeight="SemiBold" 
                                                                               FontSize="11" 
                                                                               Foreground="#34C759"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Khi chưa có lượt đếm nào -->
                                            <TextBlock Text="Chưa có lượt đếm Pass nào trong lô này" 
                                                       Foreground="#8E8E93" 
                                                       FontSize="11" 
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       Margin="8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBatchIncrements}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Stream Count Card (Stream Mode Only) -->
                        <Border Margin="0,16,0,0" 
                                Background="#E5F1FF" 
                                BorderBrush="#B3D7FF" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModelProcess}" Value="Stream">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Live Stream Detection" 
                                           FontWeight="SemiBold" 
                                           Foreground="#007AFF"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>
                                <TextBlock Foreground="#3A3A3C" FontSize="13">
                                    <Run Text="Live Count: " FontWeight="Medium"/>
                                    <Run Text="{Binding LiveStreamCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" FontSize="15" Foreground="#007AFF"/>
                                </TextBlock>
                                <TextBlock Foreground="#8E8E93" Margin="0,4,0,0" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Detection stopped"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreamingDetectionActive}" Value="True">
                                                    <Setter Property="Text" Value="Streaming AI inference active..."/>
                                                    <Setter Property="Foreground" Value="#34C759"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Camera Settings Section -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Resolution & FPS Selection -->
                        <TextBlock Text="Resolution &amp; FPS:" 
                                   Foreground="#8E8E93" 
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Margin="0,0,0,4"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding SupportedResolutions}"
                                       SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                       DisplayMemberPath="DisplayName"
                                       Padding="8,0"
                                       FontSize="12"
                                       BorderThickness="0"
                                       Background="Transparent"
                                       VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- ROI Region Settings -->
                        <TextBlock Text="ROI Region:" 
                                   Foreground="#8E8E93" 
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- X and Y -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="X (%)" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,2"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Y (%)" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,2"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Width and Height -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Width (%)" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,2"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Height (%)" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,2"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="32">
                                    <TextBox Text="{Binding RoiHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,0" FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Save & Cancel Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0"
                                    Content="Cancel" 
                                    Command="{Binding CancelSettingsCommand}"
                                    Height="36" 
                                    Background="#F2F2F7" 
                                    Foreground="#FF3B30" 
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="18" 
                                                            Padding="8,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E5E5EA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Grid.Column="2"
                                    Content="Save" 
                                    Command="{Binding ToggleSettingsCommand}"
                                    Height="36" 
                                    Background="#34C759" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="18" 
                                                            Padding="8,0">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2EB852"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Runtime Log (in-memory) -->
                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Background="#F8F9FA"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8"
                            MinHeight="150">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Runtime Log"
                                       FontWeight="SemiBold"
                                       Foreground="#1C1C1E"
                                       FontSize="13"
                                       Margin="0,0,0,6"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Logs}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                 <ListBox.ItemContainerStyle>
                                     <Style TargetType="ListBoxItem">
                                         <Setter Property="Padding" Value="0"/>
                                         <Setter Property="Margin" Value="0,0,0,4"/>
                                         <Setter Property="Background" Value="Transparent"/>
                                         <Setter Property="BorderThickness" Value="0"/>
                                         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                     </Style>
                                 </ListBox.ItemContainerStyle>
                                 <ListBox.ItemTemplate>
                                     <DataTemplate>
                                         <TextBlock Text="{Binding}"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Foreground="#8E8E93"
                                                    TextWrapping="Wrap"/>
                                     </DataTemplate>
                                 </ListBox.ItemTemplate>
                             </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
