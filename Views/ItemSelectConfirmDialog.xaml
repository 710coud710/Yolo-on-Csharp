<Window x:Class="Client.Views.ItemSelectConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm Selection" 
        Height="240" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    
    <Border Background="#F2F2F7" 
            BorderBrush="#E5E5EA" 
            BorderThickness="1" 
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="Black" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Content Area -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,12">
                <materialDesign:PackIcon x:Name="IconPack"
                                         Kind="HelpCircleOutline" 
                                         Width="40" Height="40" 
                                         Foreground="#007AFF" 
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtTitle"
                           Text="Confirm Selection" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#1C1C1E" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtMessage" 
                           Text="Are you sure you want to select this item for detection?" 
                           FontSize="12" 
                           Foreground="#8E8E93" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnCancel"
                        Grid.Column="0" 
                        Content="Cancel" 
                        Click="Cancel_Click"
                        Height="40" 
                        Background="#E5E5EA" 
                        Foreground="#3A3A3C" 
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D1D1D6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="BtnConfirm"
                        Grid.Column="2" 
                        Content="Confirm" 
                        Click="Confirm_Click"
                        Height="40" 
                        Background="#007AFF" 
                        Foreground="White" 
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0062CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
