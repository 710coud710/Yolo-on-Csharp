<UserControl x:Class="Client.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Client.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F2F2F7">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Column="0"
                       Text="Items Selection"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1C1C1E"
                       VerticalAlignment="Center"/>

            <!-- Capsule Search Box -->
            <Border Grid.Column="1" 
                    Background="#E5E5EA" 
                    CornerRadius="10" 
                    Height="36" 
                    Margin="20,0,20,0" 
                    Padding="12,0"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" 
                                             Kind="Magnify" 
                                             Width="18" 
                                             Height="18" 
                                             Foreground="#8E8E93" 
                                             VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,0"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Search by Item Code or Name..."
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="2" 
                            Command="{Binding ClearSearchCommand}"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0" 
                            Width="24" 
                            Height="24"
                            Cursor="Hand"
                            ToolTip="Clear search">
                        <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#8E8E93"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D1D1D6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Manage Dropdown -->
                <Grid Margin="0,0,10,0">
                    <Button x:Name="ManageButton"
                            Width="120"
                            Height="36"
                            Background="#34C759"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="18"
                                                    Padding="10,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2EB852"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu MinWidth="195">
                                <ContextMenu.Resources>
                                    <!-- ContextMenu custom style for rounded corners, shadow, and nice border -->
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                                        <Setter Property="HasDropShadow" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="#FFFFFF" 
                                                            BorderBrush="#E5E5EA" 
                                                            BorderThickness="1" 
                                                            CornerRadius="12" 
                                                            Padding="4">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="Black" Opacity="0.08"/>
                                                        </Border.Effect>
                                                        <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- MenuItem custom style for rounded corners highlight, icons, checkmark and padding -->
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Height" Value="36"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#1C1C1E"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="BgBorder" Background="Transparent" CornerRadius="8" Margin="2,1">
                                                        <Grid SnapsToDevicePixels="True">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" SharedSizeGroup="Icon"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30" SharedSizeGroup="Check"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            
                                                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                            
                                                            <!-- CheckMark for checkable item -->
                                                            <Path x:Name="CheckMark" Grid.Column="2" 
                                                                  Data="M 0,3 L 3,6 L 8,0" 
                                                                  Stroke="#34C759" StrokeThickness="2.2" 
                                                                  Width="9" Height="7" 
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BgBorder" Property="Background" Value="#F2F2F7"/>
                                                            <Setter Property="Foreground" Value="#1C1C1E"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Separator custom style -->
                                    <Style TargetType="Separator">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Height="1" Background="#E5E5EA" Margin="6,4"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>

                                <MenuItem Header="Add New Item" Command="{Binding OpenAddFormCommand}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#34C759"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Show Disabled Items" 
                                          IsCheckable="True" 
                                          IsChecked="{Binding ShowHiddenItems, Mode=TwoWay}"
                                          StaysOpenOnClick="True">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="EyeOff" Width="18" Height="18" Foreground="#8E8E93"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Refresh -->
                <Button Command="{Binding RefreshCommand}"
                        Width="120"
                        Height="36"
                        Background="#007AFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE72C;"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="18"
                                                Padding="10,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0062CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Items Table -->
        <Border Grid.Row="1" 
                Background="#FFFFFF" 
                BorderBrush="#E5E5EA" 
                BorderThickness="1" 
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Border x:Name="TableMask" Background="White" CornerRadius="16" IsHitTestVisible="False"/>
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="50">
                    <DataGrid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=TableMask}"/>
                    </DataGrid.OpacityMask>
                    <DataGrid.Columns>
                        <!-- Index Column (#) -->
                        <DataGridTextColumn Header="#" 
                                             Binding="{Binding Index}" 
                                             Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Item Code" 
                                             Binding="{Binding ItemCode}" 
                                             Width="1.5*"
                                             FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Item Name" 
                                             Binding="{Binding ItemName}" 
                                             Width="2.5*"/>
                        <DataGridTextColumn Header="Type" 
                                             Binding="{Binding ItemType}" 
                                             Width="1.2*"/>
                        <DataGridTextColumn Header="Model Class Name" 
                                             Binding="{Binding ClassName}"
                                             Width="1.5*"/>
                        <DataGridTextColumn Header="Class Code" 
                                             Binding="{Binding ClassCode}" 
                                             Width="1*"/>
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Select Button -->
                                        <Button Command="{Binding DataContext.ConfirmSelectItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsActive}"
                                                Content="Select"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5F1FF"/>
                                                    <Setter Property="Foreground" Value="#007AFF"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="12,2">
                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                      VerticalAlignment="Center"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#CCE3FF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#E5E5EA"/>
                                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Toggle Active Button -->
                                         <Button Command="{Binding DataContext.ConfirmToggleItemActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 CommandParameter="{Binding}"
                                                 Height="28"
                                                 BorderThickness="0"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Cursor="Hand">
                                             <Button.Style>
                                                 <Style TargetType="Button">
                                                     <Setter Property="Content" Value="Disable"/>
                                                     <Setter Property="Background" Value="#FFE5E5"/>
                                                     <Setter Property="Foreground" Value="#FF3B30"/>
                                                     <Setter Property="Template">
                                                         <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                 <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="12,2">
                                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                 </Border>
                                                             </ControlTemplate>
                                                         </Setter.Value>
                                                     </Setter>
                                                     <Style.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter Property="Background" Value="#FFCCCC"/>
                                                         </Trigger>
                                                         <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                             <Setter Property="Content" Value="Enable"/>
                                                             <Setter Property="Background" Value="#E5FFE5"/>
                                                             <Setter Property="Foreground" Value="#34C759"/>
                                                         </DataTrigger>
                                                         <MultiDataTrigger>
                                                             <MultiDataTrigger.Conditions>
                                                                 <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                 <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                             </MultiDataTrigger.Conditions>
                                                             <Setter Property="Background" Value="#CCFFCC"/>
                                                         </MultiDataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Button.Style>
                                         </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#8E8E93"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5EA"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F2F2F7"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F1FF"/>
                                    <Setter Property="Foreground" Value="#007AFF"/>                                    
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F1FF"/>
                                    <Setter Property="Foreground" Value="#007AFF"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                    <Setter Property="Foreground" Value="#8E8E93"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Loading Overlay -->
                <Border Background="#80FFFFFF"
                        CornerRadius="16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Loading items..."
                                   Foreground="#1C1C1E"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Width="200"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Consolidated Footer -->
        <Border Grid.Row="2" 
                Background="#FFFFFF" 
                BorderBrush="#E5E5EA" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="16,12" 
                Margin="0,16,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}" 
                           Foreground="#8E8E93"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                
                <!-- Pagination Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding PrevPageCommand}"
                            Width="32" 
                            Height="32"
                            Margin="0,0,10,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Previous Page">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="22" Height="22" Foreground="#1C1C1E"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F2F7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Page " Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageNumber}" FontWeight="Bold" Foreground="#007AFF" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" of " Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPages, FallbackValue=1}" FontWeight="Bold" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalCount}" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" items)" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Command="{Binding NextPageCommand}"
                            Width="32" 
                            Height="32"
                            Margin="10,0,0,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Next Page">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22" Foreground="#1C1C1E"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F2F7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Selected Item Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Selected: " 
                               FontWeight="Medium" 
                               Foreground="#8E8E93"
                               FontSize="13"/>
                    <TextBlock Text="{Binding SelectedItem.ItemCode, FallbackValue='None'}" 
                               FontWeight="Bold" 
                               Foreground="#007AFF"
                               FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add Item Overlay Panel -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#66000000"
              Visibility="{Binding IsAddFormOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#FFFFFF"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#E5E5EA"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Add New Item"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1C1C1E"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseAddFormCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32"
                                Height="32"
                                Cursor="Hand">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#8E8E93"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F2F2F7"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!-- Material Class -->
                        <TextBlock Text="Material Class *"
                                   FontWeight="SemiBold"
                                   Foreground="#3A3A3C"
                                   Margin="0,0,0,6"
                                   FontSize="13"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="38" Margin="0,0,0,15">
                            <ComboBox ItemsSource="{Binding AvailableClasses}"
                                      DisplayMemberPath="ClassName"
                                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                      Padding="10,0"
                                      FontSize="14"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Item Code -->
                        <TextBlock Text="Item Code *"
                                   FontWeight="SemiBold"
                                   Foreground="#3A3A3C"
                                   Margin="0,0,0,6"
                                   FontSize="13"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="38" Margin="0,0,0,15">
                            <TextBox Text="{Binding NewItemCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Padding="10,0"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="e.g. SCREW-M3-10"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>

                        <!-- Item Name -->
                        <TextBlock Text="Item Name *"
                                   FontWeight="SemiBold"
                                   Foreground="#3A3A3C"
                                   Margin="0,0,0,6"
                                   FontSize="13"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="38" Margin="0,0,0,15">
                            <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Padding="10,0"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="e.g. Screw M3x10 Hex Socket"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>

                        <!-- Item Type -->
                        <TextBlock Text="Item Type (Select or Type new) *"
                                   FontWeight="SemiBold"
                                   Foreground="#3A3A3C"
                                   Margin="0,0,0,6"
                                   FontSize="13"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="38" Margin="0,0,0,5">
                            <ComboBox ItemsSource="{Binding AvailableItemTypes}"
                                      Text="{Binding NewItemType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      IsEditable="True"
                                      Padding="10,0"
                                      FontSize="14"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel Button -->
                        <Button Command="{Binding CloseAddFormCommand}"
                                Content="Cancel"
                                Width="100"
                                Height="36"
                                Margin="0,0,10,0"
                                Background="#F2F2F7"
                                Foreground="#8E8E93"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E5E5EA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Add Button -->
                        <Button Command="{Binding SubmitAddItemCommand}"
                                Content="Add Item"
                                Width="110"
                                Height="36"
                                Background="#34C759"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2EB852"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
