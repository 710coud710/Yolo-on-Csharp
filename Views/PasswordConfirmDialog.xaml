<Window x:Class="Client.Views.PasswordConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Verify Password" 
        Height="280" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    
    <Border Background="#F2F2F7" 
            BorderBrush="#E5E5EA" 
            BorderThickness="1" 
            CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="Black" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header (Icon & Title) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="ShieldLockOutline" 
                                         Width="40" Height="40" 
                                         Foreground="#FF9500" 
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>
                <TextBlock Text="Password Required" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#1C1C1E" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Confirm this action by entering the machine password." 
                           FontSize="12" 
                           Foreground="#8E8E93" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Input & Error Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#E5E5EA" Background="White" Height="40">
                    <PasswordBox x:Name="TxtPassword" 
                                 Padding="12,0"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                 materialDesign:HintAssist.Hint="Enter password"
                                 materialDesign:HintAssist.Foreground="#C7C7CC"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Border>
                
                <TextBlock x:Name="LblError" 
                           Foreground="#FF3B30" 
                           FontSize="15" 
                           FontWeight="Medium" 
                           Margin="0,8,0,0" 
                           TextAlignment="Center" 
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                        Content="Cancel" 
                        Click="Cancel_Click"
                        Height="40" 
                        Background="#E5E5EA" 
                        Foreground="#3A3A3C" 
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D1D1D6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Grid.Column="2" 
                        x:Name="BtnConfirm"
                        Content="Verify" 
                        Click="Confirm_Click"
                        Height="40" 
                        Background="#007AFF" 
                        Foreground="White" 
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0062CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
